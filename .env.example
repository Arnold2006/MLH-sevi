# Lokal udvikling: standard-adgangskoden "changeme" virker med det samme.
# Før produktion: skift BEGGE værdier til lange, tilfældige strenge.
# Ændres ADMIN_SECRET, logges alle aktive sessioner automatisk ud.
ADMIN_PASSWORD=changeme
ADMIN_SECRET=replace-this-with-a-long-random-string

# Valgfrit men anbefalet: Cloudflare Turnstile mod robot-spam i kontaktformularen
# Opret nøgler på https://dash.cloudflare.com/?to=/:account/turnstile
# Uden nøgler virker formularen stadig med honeypots + tidsfælde + rate-limit
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Husk også på serveren: NEXT_PUBLIC_SITE_URL=https://dit-domæne.dk
